# Backend
PORT=5000
MONGODB_URI=mongodb://127.0.0.1:27017/clinic-hms

# Frontend URL used for CORS and staff invitation links.
CLIENT_URL=http://localhost:5173

# Authentication
JWT_SECRET=replace-with-a-long-random-secret
# Preferred setting; accepts jsonwebtoken durations such as 1d or 30d.
JWT_EXPIRES_IN=30d
# Legacy duration in days. Used only when JWT_EXPIRES_IN is not set.
JWT_COOKIE_EXPIRES_IN=30

# SMTP account used to send staff invitations.
SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=your-smtp-username
SMTP_PASS=your-smtp-password
EMAIL_FROM="Clinic HMS <no-reply@example.com>"
